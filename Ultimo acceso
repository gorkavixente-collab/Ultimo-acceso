1|// Multipart upload that works in BOTH runtimes. Use this for every file upload; never
2|// build the FormData part yourself.
3|//
4|//   import { uploadForm } from "@/src/utils/upload";
5|//   const res = await uploadForm(`${BACKEND_URL}/api/photos`, {
6|//     fields: { caption },
7|//     files: { image: { uri: asset.uri, name: "photo.jpg", mimeType: asset.mimeType } },
8|//   });
9|//
10|// Why: on a phone the global fetch is `expo/fetch` (SDK 54+), which rejects the old RN
11|// `{ uri, name, type }` part with "Unsupported FormDataPart implementation". The web
12|// preview accepts that shape, so the bug only shows on a device. Never set Content-Type:
13|// the runtime adds the multipart boundary. No extra dependency: `expo/fetch` reads
14|// `file://` on iOS and Android itself (React Native's own fetch cannot on Android).
15|
16|import { Platform } from "react-native";
17|import { fetch as expoFetch } from "expo/fetch";
18|
19|export type LocalFile = {
20|  uri: string; // asset.uri from expo-image-picker / expo-document-picker / expo-audio
21|  name?: string; // "photo.jpg"; last path segment of uri when omitted
22|  mimeType?: string; // asset.mimeType, e.g. "image/jpeg"
23|};
24|
25|export type UploadOptions = {
26|  files: Record<string, LocalFile>; // form field name -> file
27|  fields?: Record<string, string>;
28|  method?: "POST" | "PUT";
29|  headers?: Record<string, string>; // auth only; never Content-Type
30|  signal?: AbortSignal;
31|};
32|
33|export function fileNameFor(file: LocalFile): string {
34|  return file.name || file.uri.split("?")[0].split("/").pop() || "file";
35|}
