50|export async function uploadForm(url: string, opts: UploadOptions): Promise<Response> {
51|  const form = new FormData();
52|  for (const [k, v] of Object.entries(opts.fields ?? {})) form.append(k, v);
53|  for (const [field, file] of Object.entries(opts.files)) {
