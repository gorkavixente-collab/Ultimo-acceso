58|    body: form,
59|    headers: opts.headers, // the runtime adds the multipart boundary
60|    signal: opts.signal,
61|  };
62|  // Branch the call, not the function reference: the two fetches have different RequestInit types.
63|  return Platform.OS === "web" ? fetch(url, init) : expoFetch(url, init);
