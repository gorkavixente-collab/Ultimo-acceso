37|// Turn a local file into a part that the current runtime's fetch can serialise.
38|export async function toFormDataPart(file: LocalFile): Promise<Blob> {
39|  if (Platform.OS === "web") {
40|    // blob:/data: URL from the browser picker; the browser fetch reads it fine.
41|    const blob = await (await fetch(file.uri)).blob();
42|    const type = file.mimeType || blob.type;
43|    return type && type !== blob.type ? new Blob([blob], { type }) : blob;
44|  }
45|  // Native: read the local file through expo/fetch (never the RN fetch) and append the Blob.
46|  const blob = await (await expoFetch(file.uri)).blob();
47|  return file.mimeType && file.mimeType !== blob.type ? new Blob([blob], { type: file.mimeType }) : blob;
48|}
